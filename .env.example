# Copia este ficheiro para ".env" e preenche com os valores reais.
# O ".env" NUNCA deve ser commitado (já está no .gitignore).

# Token do bot do Telegram (obtido via @BotFather)
TELEGRAM_TOKEN=coloca_aqui_o_teu_token

# Caminho para o ficheiro JSON da service account da Google
# (o próprio ficheiro .json também não deve ser commitado)
GOOGLE_APPLICATION_CREDENTIALS=secrets/weekly-report-service-account.json

BOT_USERNAME=

# Example: TELEGRAM_WHITELIST=-1000000000000,-500000000
TELEGRAM_WHITELIST=

FORMS_LINK=https://forms.gle/example
